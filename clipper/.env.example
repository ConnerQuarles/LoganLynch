# Copy to .env and fill in. Never commit .env.

# The subdomain you pointed at this VPS (DNS A record -> VPS IP).
CLIP_DOMAIN=clips.example.com

# Password for the site (the browser asks for it; any username works).
# Make it long: this page burns your CPU and API credits.
CLIP_PASSWORD=change-me-to-something-long

# Optional, but without it scores only rank moments within each video.
ANTHROPIC_API_KEY=

# small = good accuracy. On a 1-2 core VPS use base (faster, a bit less accurate).
CLIP_WHISPER_MODEL=small

# Delete uploaded videos and clips after this many hours.
CLIP_KEEP_HOURS=24

# --- Only for docker-compose.traefik.yml (VPS already running Traefik/n8n) ---
# Find it with:  docker network ls   (the network your traefik container is on)
TRAEFIK_NETWORK=root_default
TRAEFIK_CERTRESOLVER=mytlschallenge
TRAEFIK_ENTRYPOINT=websecure
